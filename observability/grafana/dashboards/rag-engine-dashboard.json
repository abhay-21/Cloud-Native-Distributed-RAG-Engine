        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vector(50)",
          "legendFormat": "HPA threshold (50)",
          "refId": "C"
        }
      ],
      "title": "Redis Queue Depth & Simulated HPA Pod Replicas",
      "type": "timeseries"
    },

