          "legendFormat": "P95 Search Latency (ms)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_vector_search_latency_ms_bucket[1m])))",
          "legendFormat": "P50 Search Latency (ms)",
          "refId": "B"
        }
      ],
